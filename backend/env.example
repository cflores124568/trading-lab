# Trading Lab - .env.example
# Copy this file to .env and fill in your values

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

SECRET_KEY=

# When you add PostgreSQL:
# DATABASE_URL=
# or
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=trading_lab
# DB_USER=
# DB_PASSWORD=

# Optional backtesting defaults
INITIAL_CAPITAL=100000
COMMISSION_PER_CONTRACT=2.50
SLIPPAGE_PIPS=0.25

LOG_LEVEL=INFO