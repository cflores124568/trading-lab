# Trading Lab - .env.example
# Copy this file to .env and fill in your values

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
SECRET_KEY=mysterious-string
ALLOWED_ORIGINS=http://localhost:3000

# Database
# Local development talks to the Dockerized DB through localhost.
DATABASE_URL=postgresql://trading:trading@localhost:5432/trading_lab

# Used by docker-compose to load Postgres
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading_lab

#Databento ftw
#Get you one at: https://databento.com/portal/keys
DATABENTO_API_KEY=

# Optional backtesting defaults
INITIAL_CAPITAL=100000
COMMISSION_PER_CONTRACT=2.50
SLIPPAGE_PIPS=0.25

LOG_LEVEL=INFO
