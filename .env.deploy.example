# Copy this file to .env on the EC2 host. Never commit the resulting .env file.
POSTGRES_USER=trading
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=trading_lab

# Use the public HTTP origin at first, then switch to https://your-domain after TLS is configured.
ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# Optional. Keep this secret server-side.
DATABENTO_API_KEY=
